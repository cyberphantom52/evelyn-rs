// Oplus ROMs (ColorOS, OxygenOS): the property files their init loads, and the
// features their permissions and extension XML declare.
Kit(
    // Oplus's init loads each my_* partition's properties after Android's, so a
    // value there wins. Seen on a device: my_product after product, my_region
    // after my_product, and my_manifest after all of them; no two of the others
    // gave a key different values, so their order among themselves is not known.
    property_files: [
        "/my_product/build.prop",
        "/my_region/build.prop",
        "/my_stock/build.prop",
        "/my_heytap/build.prop",
        "/my_carrier/build.prop",
        "/my_company/build.prop",
        "/my_preload/build.prop",
        "/my_bigball/build.prop",
        "/my_engineering/build.prop",
        "/my_manifest/build.prop",
    ],
    operations: {
        // `EnableFeature(Android("…"))`: `<feature name=…>`, in the Android features'
        // file, or in `file`; one already declared is replaced.
        "EnableFeature(Android)": (
            parameters: ["name"],
            defaults: {"file": "/my_product/etc/permissions/com.oplus.android-features.xml"},
            operations: [
                EditXml(target: "{file}", edits: [
                    PutChild(parent: "permissions", key: "feature[@name='{name}']", element: "<feature name=\"{name}\"/>", create: true),
                ]),
            ],
        ),
        // `EnableFeature(Oplus("…"))`: `<oplus-feature name=…>`, in the Oplus
        // features' file, or in `file`.
        "EnableFeature(Oplus)": (
            parameters: ["name"],
            defaults: {"file": "/my_product/etc/permissions/oplus.feature.android.xml"},
            operations: [
                EditXml(target: "{file}", edits: [
                    PutChild(parent: "oplus-config", key: "oplus-feature[@name='{name}']", element: "<oplus-feature name=\"{name}\"/>", create: true),
                ]),
            ],
        ),
        // `EnableFeature(App(name: "…", file: "/…"))`: `<app_feature name=…>`, in an
        // extension file, with `args` if they are given.
        "EnableFeature(App)": (
            parameters: ["name", "file"],
            defaults: {"args": ""},
            operations: [
                EditXml(target: "{file}", edits: [
                    PutChild(parent: "extend_features", key: "app_feature[@name='{name}']", element: "<app_feature name=\"{name}\"/>", create: true),
                ]),
                When(condition: Matches("{args}", "."), operations: [
                    EditXml(target: "{file}", edits: [
                        SetAttribute(path: "extend_features/app_feature[@name='{name}']", name: "args", value: "{args}", create: true),
                    ]),
                ]),
            ],
        ),
        // Remove a feature of any kind from every permissions and extension XML that
        // mentions it; the others are not touched, or even parsed.
        "DisableFeature": (
            parameters: ["name"],
            operations: [
                ForEach(
                    over: Filter(
                        over: Union([Build("/*/etc/permissions/*.xml"), Build("/*/etc/extension/*.xml")]),
                        name: "file",
                        keep: Contains(Read(Build("{file}")), "{name}"),
                    ),
                    name: "file",
                    operations: [
                        EditXml(target: "{file}", edits: [
                            Remove(path: "//feature[@name='{name}']"),
                            Remove(path: "//oplus-feature[@name='{name}']"),
                            Remove(path: "//app_feature[@name='{name}']"),
                        ]),
                    ],
                ),
            ],
        ),
    },
)
