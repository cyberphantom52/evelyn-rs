// A debug build (`evelyn build --debug`), applied after every other patch: logcat
// and the kernel log written to /data/local/tmp/logs until boot completes, and adb
// on from boot without authorisation.
[
    Step("debug-logging", [
        Install("logcat.rc", "/vendor/etc/init/logcat.rc"),
    ]),
    Step("debug-adb", [
        Props(Build("/vendor/build.prop"), [
            Set("ro.adb.secure", "0"),
            Set("ro.secure", "0"),
            Set("ro.debuggable", "1"),
            Set("persist.sys.usb.config", "mtp,adb"),
        ]),
    ]),
]
