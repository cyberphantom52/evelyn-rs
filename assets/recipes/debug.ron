// A debug build (`evelyn build --debug`), applied after every other patch: logcat
// and the kernel log written to /data/local/tmp/logs until boot completes, and adb
// on from boot without authorisation.
[
    Step("debug-logging", [
        Install("logcat.rc", "/vendor/etc/init/logcat.rc"),
        Policy("/vendor/etc/selinux/vendor_sepolicy.cil", [Add("bootlog.te")]),
    ]),
    // In the system partition's build.prop: init applies a vendor-side one's
    // properties with vendor_init's policy, which may not set these, so with
    // SELinux enforcing they would not override the ROM's.
    Step("debug-adb", [
        Props(Build("/system/build.prop"), [
            Set("ro.adb.secure", "0"),
            Set("ro.secure", "0"),
            Set("ro.debuggable", "1"),
            Set("persist.sys.usb.config", "mtp,adb"),
        ]),
    ]),
]
